APP_NAME=Enterprise Agent
DEBUG=false

DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/enterprise_agent
REDIS_URL=redis://localhost:6379/0

# LLM（Day 2 起使用，OpenAI 兼容协议）
# 留空 LLM_API_KEY 时自动降级为离线 FakeProvider，服务仍能启动
LLM_PROVIDER=openai
LLM_MODEL=glm-4.7-flash
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

LLM_TEMPERATURE=0.2
# 推理模型（如 GLM-4.7-Flash）默认会输出思维链并占满 max_tokens，务必留足余量
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# 思维链开关：enabled / disabled / auto
# GLM-4.7-Flash 等推理模型建议设 disabled，否则思维链会吃掉 max_tokens 导致 content 为空
LLM_THINKING=disabled

# Embedding（Day 4 起使用）
# 换 embedding 模型必须同步 EMBEDDING_DIM 并用 Alembic 重建向量列
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
