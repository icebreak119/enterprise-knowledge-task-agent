APP_NAME=Enterprise Agent
DEBUG=false

DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/enterprise_agent
REDIS_URL=redis://localhost:6379/0

# LLM（Day 2 起使用，OpenAI 兼容协议）
# 留空 LLM_API_KEY 时自动降级为离线 FakeProvider，服务仍能启动
LLM_PROVIDER=openai
LLM_MODEL=qwen3.6-flash
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

LLM_TEMPERATURE=0.2
# 推理模型（GLM-4.x / Qwen3）默认会输出思维链，可能占满 max_tokens，务必留足余量
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# 厂商私有参数（JSON 对象，原样并入请求体），留空则不传。
# 关闭思维链各家字段不统一，换厂商时记得一起改：
#   智谱 GLM      LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
#   阿里云 Qwen3  LLM_EXTRA_BODY={"enable_thinking": false}
LLM_EXTRA_BODY=

# Embedding
# 换 embedding 模型必须同步 EMBEDDING_DIM 并用 Alembic 重建向量列。
# 阿里云百炼实测：qwen3.7-text-embedding / -flash 均为 1024 维。
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BATCH_SIZE=32

# 检索
# rag_max_distance 是拒答阈值（余弦距离，越小越相似）：超过就认为库里没有相关资料。
# 当前值只是保守初值，必须用评测集里"相关/不相关"样本的距离分布标定后才算数。
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.5
